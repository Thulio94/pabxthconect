FROM node:22-alpine AS assets
WORKDIR /build
COPY app/package.json app/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY app/resources ./resources
COPY app/public ./public
COPY app/vite.config.js ./vite.config.js
RUN npm run build

FROM nginx:1.27-alpine
COPY production/nginx.conf /etc/nginx/conf.d/default.conf
COPY app/public /var/www/html/public
COPY --from=assets /build/public/build /var/www/html/public/build
HEALTHCHECK --interval=15s --timeout=5s --retries=10 CMD wget -qO- http://127.0.0.1/up >/dev/null 2>&1 || exit 1
