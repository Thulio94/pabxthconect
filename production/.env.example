APP_NAME="Tela do Agente - Thconect"
APP_KEY=base64:SUBSTITUA_POR_UMA_CHAVE_LARAVEL
APP_URL=https://phone.seudominio.com.br
LOG_LEVEL=warning

DB_DATABASE=pabx_thconect
DB_USERNAME=pabx_thconect
DB_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
REDIS_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_FORTE

PBX_AMI_USERNAME=laravel
PBX_AMI_SECRET=SUBSTITUA_POR_SEGREDO_AMI_FORTE
PBX_PUBLIC_IP=203.0.113.10
PBX_LOCAL_NET=10.0.0.0/8
PBX_DOCKER_LOCAL_NET=172.16.0.0/12
PBX_SIP_DOMAIN=ws.seudominio.com.br
PBX_WEBSOCKET_URL=wss://ws.seudominio.com.br/asterisk/ws

# TURN: use a DNS-only hostname (never proxied by Cloudflare) and a distinct
# random secret. Certificates are mounted in the turn_certs volume at the
# paths below; leave TURN_TLS_ENABLED=false only for local diagnostics.
TURN_PUBLIC_HOST=turn.seudominio.com.br
TURN_REALM=turn.seudominio.com.br
TURN_AUTH_SECRET=SUBSTITUA_POR_SEGREDO_TURN_FORTE
TURN_CREDENTIAL_TTL_SECONDS=900
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49359
# Usually determined automatically from the service's Docker address. Set only
# if the VPS uses an unusual container network.
TURN_INTERNAL_IP=
TURN_TLS_ENABLED=true
TURN_TLS_CERT_FILE=/etc/coturn/certs/live/turn.seudominio.com.br/fullchain.pem
TURN_TLS_KEY_FILE=/etc/coturn/certs/live/turn.seudominio.com.br/privkey.pem
TURN_CERT_DOMAIN=turn.seudominio.com.br
TURN_CERT_EMAIL=infra@seudominio.com.br
TURN_CERT_RENEW_INTERVAL_SECONDS=43200
# Adicione o valor real somente no ambiente do Easypanel. Nunca o versione.
CLOUDFLARE_DNS_API_TOKEN=SUBSTITUA_NO_EASYPANEL
